# syntax=docker/dockerfile:1.6
#
# Forgather runtime image (user-agnostic, distributable).
#
# In contrast to the dev image (`Dockerfile`), this image:
#   - has a fixed in-container user `forgather` (UID/GID 1000) that is
#     remapped at container start via PUID/PGID env vars, so a single
#     prebuilt image works for any host user
#   - bakes the full source tree in at /opt/forgather/repo (editable
#     install — required because `forgather server` resolves
#     `tools/forgather_server/server.py` relative to the package's
#     own __file__, and the FastAPI app likewise resolves the SPA's
#     `webui/dist/` relative to its own __file__)
#   - prebuilds the webui SPA bundle at build time, so the server
#     can serve it on first start without any post-install steps
#   - defaults to running `forgather server -H 0.0.0.0 -p 8765` and
#     uses bridge networking + port forward for portability
#   - drops privileges via gosu in the entrypoint after remap
#
# See `docker/runtime/README.md` for the user-facing docs.

FROM ubuntu:24.04

ARG VENV_DIR=/opt/forgather/venv
ARG REPO_DIR=/opt/forgather/repo
ARG USER_NAME=forgather
ARG USER_UID=1000
ARG USER_GID=1000

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    UV_LINK_MODE=copy \
    VIRTUAL_ENV=${VENV_DIR} \
    PATH=${VENV_DIR}/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# ---------------------------------------------------------------------------
# System packages. Same baseline as the dev image, plus `gosu` for the
# privilege-drop entrypoint. The "developer convenience" tools (vim,
# tmux, htop, ...) are still useful for the diagnostic shell flow
# (`docker exec -u forgather -ti <name> bash`), so we keep them.
# ---------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3.12 \
        python3.12-venv \
        python3.12-dev \
        python3-pip \
        build-essential \
        ca-certificates \
        git \
        git-lfs \
        graphviz \
        nodejs \
        npm \
        gosu \
        bash-completion \
        curl \
        wget \
        less \
        vim \
        tmux \
        htop \
        tree \
        jq \
        ripgrep \
        unzip \
        zip \
        rsync \
        openssh-client \
        gnupg \
        locales \
        tzdata \
    && locale-gen en_US.UTF-8 \
    && rm -rf /var/lib/apt/lists/* \
    && gosu nobody true

# ---------------------------------------------------------------------------
# Install uv (fast Python package manager).
# ---------------------------------------------------------------------------
ADD --chmod=755 https://astral.sh/uv/install.sh /tmp/uv-install.sh
RUN UV_INSTALL_DIR=/usr/local/bin /tmp/uv-install.sh \
    && rm -f /tmp/uv-install.sh \
    && uv --version

# ---------------------------------------------------------------------------
# Create the in-container user (fixed UID 1000 — the entrypoint remaps
# at container start). If the stock Ubuntu 24.04 `ubuntu` user already
# holds UID 1000, delete it first so our build arg always wins.
# ---------------------------------------------------------------------------
RUN set -eux; \
    if id -u ubuntu >/dev/null 2>&1 && [ "$(id -u ubuntu)" = "${USER_UID}" ]; then \
        userdel -r ubuntu 2>/dev/null || userdel ubuntu; \
    fi; \
    if ! getent group "${USER_GID}" >/dev/null; then \
        groupadd --gid "${USER_GID}" "${USER_NAME}"; \
    fi; \
    if ! id -u "${USER_NAME}" >/dev/null 2>&1; then \
        useradd --uid "${USER_UID}" --gid "${USER_GID}" \
            --shell /bin/bash --create-home "${USER_NAME}"; \
    fi; \
    install -d -o "${USER_UID}" -g "${USER_GID}" /opt/forgather

# ---------------------------------------------------------------------------
# Build the venv and install dependencies as the unprivileged user, so
# every venv file is correctly owned from the start (no slow recursive
# chown later).
# ---------------------------------------------------------------------------
USER ${USER_NAME}

RUN uv venv --python python3.12 --seed ${VENV_DIR}

# Bake the full source tree into the image at ${REPO_DIR}. We copy
# rather than bind-mount because we need a persistent in-image tree:
# `forgather server` walks up from src/forgather/cli/server.py to find
# tools/forgather_server/server.py, and the FastAPI app resolves
# webui/dist/ relative to its own __file__. Editable install
# preserves both lookups.
#
# `.dockerignore` already strips `output_models/`, `webui/node_modules/`,
# `webui/dist/`, and other heavy/regen-able paths from the build
# context, so this stays small.
COPY --chown=${USER_UID}:${USER_GID} . ${REPO_DIR}

# Install Forgather (editable) from the baked-in tree. Editable mode
# is required so that the file-walk in `forgather server` resolves
# correctly; the source tree is frozen anyway because there's no
# host bind-mount.
RUN --mount=type=cache,target=/home/${USER_NAME}/.cache/uv,uid=${USER_UID},gid=${USER_GID} \
    uv pip install --python ${VENV_DIR}/bin/python -e ${REPO_DIR}

# cut-cross-entropy from source for bf16/fp16 numerical stability
# (the pip release lacks the accum_e_fp32 / accum_c_fp32 features).
RUN --mount=type=cache,target=/home/${USER_NAME}/.cache/uv,uid=${USER_UID},gid=${USER_GID} \
    uv pip install --python ${VENV_DIR}/bin/python \
        "cut-cross-entropy @ git+https://github.com/apple/ml-cross-entropy.git"

# TensorBoard <= 2.20.0 imports `pkg_resources` at module load, but
# setuptools 82 (Feb 2026) removed it. Backport the fix.
RUN ${VENV_DIR}/bin/python ${REPO_DIR}/docker/patches/fix_tensorboard_pkg_resources.py

# Build the SPA bundle in-image. Output lands at
# ${REPO_DIR}/tools/forgather_server/webui/dist/ — exactly where
# tools/forgather_server/app.py looks for it at runtime.
RUN cd ${REPO_DIR} && ./build-webui.sh \
    && rm -rf ${REPO_DIR}/tools/forgather_server/webui/node_modules

# ---------------------------------------------------------------------------
# Back to root for the entrypoint setup. The entrypoint runs as root
# so it can usermod/chown for UID/GID remap, then drops to the
# forgather user via gosu before exec'ing the real command.
# ---------------------------------------------------------------------------
USER root

# Activate the venv in every interactive shell (used by
# `docker exec -u forgather -ti <name> bash` for diagnostics).
RUN printf '%s\n' \
        '# Forgather venv (baked in at image build)' \
        'export VIRTUAL_ENV=/opt/forgather/venv' \
        'export PATH="$VIRTUAL_ENV/bin:$PATH"' \
        > /etc/profile.d/10-forgather-venv.sh \
    && chmod 0644 /etc/profile.d/10-forgather-venv.sh \
    && printf '\n# Forgather venv\n. /etc/profile.d/10-forgather-venv.sh\n' \
        >> /etc/bash.bashrc

COPY --chmod=755 docker/runtime/entrypoint.sh /usr/local/bin/forgather-runtime-entrypoint

# Volumes (advisory — the run wrapper sets the actual mounts).
VOLUME ["/home/forgather/.forgather", "/home/forgather/.cache/huggingface"]

EXPOSE 8765

WORKDIR /home/forgather

ENTRYPOINT ["/usr/local/bin/forgather-runtime-entrypoint"]
CMD ["forgather", "server", "-H", "0.0.0.0", "-p", "8765"]
